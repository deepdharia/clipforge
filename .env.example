# Environment variables are NOT required for production or local development
# This file documents optional overrides only

# Optional: Set custom dev server port (defaults to 5173)
# PORT=5173

# Optional: Set URL base path if deploying to a subpath (defaults to /)
# BASE_PATH=/

# Optional: Environment (auto-set to 'production' by Vercel)
# NODE_ENV=production

# Note: Remove these lines before committing—they should only be used locally
# if you need non-default values. Better to just use defaults.
